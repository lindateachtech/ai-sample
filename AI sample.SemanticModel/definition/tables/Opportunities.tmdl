/// Sales opportunities (deals). Use as the fact table for revenue, pipeline, forecast, and win/loss analysis. Filter by owner, product, campaign, stage, or close date.
table Opportunities
	lineageTag: 574e7ea3-1c8d-44ef-8571-714b66f865c7

	/// Total closed-won revenue. Use as the main KPI for actual sales performance. Pairs with Rev Goal for attainment.
	measure 'Revenue Won' = ```
			
			 CALCULATE(
			     SUMX(Opportunities, Opportunities[Value]),
			     FILTER(Opportunities, Opportunities[Status] = "Won")
			 )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue
		lineageTag: 4175e2ae-8428-461a-854b-9a68cf5b5b8c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Weighted revenue for opportunities still open (Value × Probability). Use to size the current pipeline.
	measure 'Revenue In Pipeline' = ```
			
			VAR Revenue =
			    CALCULATE (
			        SUMX ( Opportunities, Opportunities[Value] ),
			        FILTER (
			            Opportunities,
			            Opportunities[Status] = "Open"
			            && VALUE(LEFT(Opportunities[Pipeline Step],1)) >=2
			        )
			    )
			RETURN
			    Revenue + ( Revenue * ( 'Opportunity Forecast Adjustment'[Forecast Adjustment Value] / 100 ) )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue
		lineageTag: 1322f812-7712-498e-9f4d-ba6b80052388

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Forecast attainment = Forecast ÷ Rev Goal. Show as a gauge or KPI to track pace toward quota.
	measure 'Forecast %' = (([Revenue Won]+[Revenue In Pipeline]))/ [Rev Goal]
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Forecast
		lineageTag: 78a5c219-6674-49f8-a2c5-4da21114763d

	/// Won revenue plus weighted open pipeline, with manual adjustments. Use as the headline forecast KPI.
	measure Forecast = ([Revenue Won]+[Revenue In Pipeline])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Forecast
		lineageTag: f3eb5c0a-9667-445a-b762-e4e9f911c533

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Number of opportunities still open. Use in pipeline funnel and stage-mix visuals.
	measure 'Opportunity Count In Pipeline' = ```
			
			    CALCULATE (
			        COUNT( Opportunities[Value] ),
			        FILTER (
			            Opportunities,
			            Opportunities[Status] = "Open"
			              --  && Opportunities[PipelineStep] IN { "3-Pipeline", "4-Mandate", "5-Close" }
			        )
			    )
			
			```
		formatString: #,0
		displayFolder: Counts
		lineageTag: b4effa85-1aa3-4f33-a3ef-07ec57b59c0f

	/// Total opportunities in the period. Use as a volume metric or denominator for conversion rates.
	measure 'Opportunity Count' =
			
			COUNTAX(Opportunities,TRUE())
		formatString: #,0
		displayFolder: Counts
		lineageTag: f9cdd5b7-71b0-42ca-b100-d957cbdaa375

	/// Number of closed-won deals. Use in win/loss and rep leaderboard visuals.
	measure 'Count of Won' = ```
			
			COUNTAX(
			    FILTER(
			        KEEPFILTERS(Opportunities),Opportunities[Status] = "Won"
			        ),
			    Opportunities[OpportunitySeq]
			    ) 
			```
		formatString: #,0
		displayFolder: Counts
		lineageTag: 61908284-58b6-4ce1-b980-2cd65b89fafd

	/// Number of closed-lost deals. Use to spot rep, product, or stage patterns in losses.
	measure 'Count of Lost' = ```
			
			COUNTAX(
			    FILTER(
			        KEEPFILTERS(Opportunities),Opportunities[Status] = "Lost"
			        ),
			    Opportunities[OpportunitySeq]
			    ) 
			```
		formatString: #,0
		displayFolder: Counts
		lineageTag: 0995fcc4-bb40-4d35-aac9-9ecf60f69bbe

	/// Win rate = Count of Won ÷ (Won + Lost). Use as a KPI card and to compare reps, products, or segments.
	measure 'Close %' = [Count of Won]/([Count of Won]+[Count of Lost])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Counts
		lineageTag: 938be727-4972-4ef9-a507-da6a1d898703

	/// Unweighted revenue for open deals. Use to see raw pipeline exposure before probability weighting.
	measure 'Revenue Open' =
			
			CALCULATE(
			     SUMX(Opportunities, Opportunities[Value]),
			     FILTER(Opportunities, Opportunities[Status] = "Open")
			 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue
		lineageTag: d8ffa47c-94b4-4585-9170-43b31ec2dd1d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Closed-won revenue attributed to the opportunity's Deal Owner (not the Account Owner). Use in rep leaderboards for deal credit.
	measure 'Revenue Won (by Deal Owner)' = CALCULATE ( [Revenue Won], USERELATIONSHIP ( Opportunities[SystemUserSeq], Owners[SystemUserSeq] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue (by Deal Owner)
		lineageTag: 6d47b677-faa9-4686-95bd-9356ece3a22b

	/// Weighted open pipeline attributed to the opportunity's Deal Owner. Use in rep pipeline health visuals.
	measure 'Revenue In Pipeline (by Deal Owner)' = CALCULATE ( [Revenue In Pipeline], USERELATIONSHIP ( Opportunities[SystemUserSeq], Owners[SystemUserSeq] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue (by Deal Owner)
		lineageTag: e73838b5-045f-48c2-99f3-cf41154a12b3

	/// Forecast attributed to the opportunity's Deal Owner. Use as the rep-level forecast KPI.
	measure 'Forecast (by Deal Owner)' = CALCULATE ( [Forecast], USERELATIONSHIP ( Opportunities[SystemUserSeq], Owners[SystemUserSeq] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Forecast (by Deal Owner)
		lineageTag: 5ebedab4-6756-4e95-a226-3fd57b90cef9

	/// Win rate for deals attributed to the Deal Owner. Use in rep scorecards.
	measure 'Close % (by Deal Owner)' = CALCULATE ( [Close %], USERELATIONSHIP ( Opportunities[SystemUserSeq], Owners[SystemUserSeq] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Counts (by Deal Owner)
		lineageTag: 7d2a3dd9-c316-4a96-b608-e57f85cb7163

	/// Customer's stated budget. Use to compare against deal value.
	column Budget
		dataType: int64
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Financials
		lineageTag: 556ef9d9-7d5a-45a7-8e33-2105b953a479
		summarizeBy: sum
		sourceColumn: Budget

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

