	/// Open / Won / Lost. Use as a slicer for pipeline vs closed analysis.
	column Status
		dataType: string
		displayFolder: Details
		lineageTag: f9b0d395-092e-4efb-9bac-3e9c3e90267c
		summarizeBy: none
		sourceColumn: Status

