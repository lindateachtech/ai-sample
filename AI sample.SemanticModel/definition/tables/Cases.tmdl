/// Customer support tickets. Use as the fact table for case volume, SLA, escalations, resolution time, and CSAT analysis.
table Cases
	lineageTag: e1332845-db9f-4fd5-bdd8-1975aba5f89c

	/// Total case volume. Use as the primary KPI for support workload and demand trends.
	measure 'Case Count' = ```
			
			    COUNTROWS('Cases')
			```
		formatString: #,0
		displayFolder: Volume
		lineageTag: 630119c6-8b94-4bac-9e02-622657830537

		changedProperty = IsHidden

	/// Share of cases that were escalated. Show as a KPI; lower is better. Pairs with Escalations Goal.
	measure Escalations = DIVIDE(CALCULATE(COUNTROWS('Cases'),'Cases'[Is Escalated] = TRUE()) , [Case Count],0)
		formatString: #,0%;-#,0%;#,0%
		displayFolder: SLA & Escalations
		lineageTag: dfcdb20a-e5c2-4ff9-a079-e2b5cbf200df

		changedProperty = IsHidden

	/// Share of cases that met the SLA. Show as a KPI; higher is better. Pairs with SLA Compliance Goal.
	measure 'SLA Compliance' = DIVIDE(CALCULATE(COUNTROWS('Cases'),'Cases'[Is SLA Violation] = FALSE()) , [Case Count],0)
		formatString: #,0%;-#,0%;#,0%
		displayFolder: SLA & Escalations
		lineageTag: 42499aa2-43d2-4bbd-a15c-0127fe4f803d

		changedProperty = IsHidden

	/// Month-over-month change in case volume. Use as a trend KPI with conditional formatting.
	measure 'Cases MoM%' =
			
			VAR __PREV_MONTH = CALCULATE([Case Count], DATEADD('Case Calendar'[Date], -1, MONTH))
			RETURN
				DIVIDE([Case Count] - __PREV_MONTH, __PREV_MONTH)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Volume
		lineageTag: bdada272-d3c7-43e5-a184-8ad4ff2fd286

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MonthOverMonth"
				}

		changedProperty = IsHidden

	/// Product's share of total cases. Use in stacked bars or treemaps to see where volume concentrates.
	measure 'Cases % by Product' =
			
			DIVIDE(
			        [Case Count],
			        CALCULATE(
			            [Case Count],All('Products')
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Volume
		lineageTag: f95e8dcf-717e-4747-afda-373172afe456

		changedProperty = IsHidden

	/// Subject's share of total cases. Use to find the top drivers of support demand.
	measure 'Cases % by Subject' =
			
			DIVIDE(
			        [Case Count],
			        CALCULATE(
			            [Case Count],All('Cases'[Subject])
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Volume
		lineageTag: b82dcd07-3b84-410e-b1ac-70eb6ce9c060

		changedProperty = IsHidden

	/// Estimated overall lift in CSAT from resolving problem cases. Use as a headline impact KPI.
	measure 'CSAT Impact' =
			
			VAR FactorAvg =
			    AVERAGE ( 'Cases'[CSAT] )
			VAR AllAvg =
			    CALCULATE ( AVERAGE ( 'Cases'[CSAT] ), ALL ( 'Cases' ) )
			VAR AllAvgExcept =
			    CALCULATE (
			        AVERAGE ( 'Cases'[CSAT] ),
			        FILTER ( ALL ( 'Cases' ), 'Cases'[Topic] <> SELECTEDVALUE ( 'Cases'[Topic] ) )
			    )
			RETURN
			    1 - ( AllAvgExcept / AllAvg )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CSAT
		lineageTag: e842c1f9-9e35-412e-9ddf-af466920099a

		changedProperty = IsHidden

	/// CSAT lift attributable to a subject. Use to prioritize which case topics to fix first.
	measure 'CSAT Impact - Subject' =
			
			VAR FactorAvg =
			    AVERAGE ( 'Cases'[CSAT] )
			VAR AllAvg =
			    CALCULATE ( AVERAGE ( 'Cases'[CSAT] ), ALL ( 'Cases' ) )
			VAR AllAvgExcept =
			    CALCULATE (
			        AVERAGE ( 'Cases'[CSAT] ),
			        FILTER ( ALL ( 'Cases' ), 'Cases'[Subject] <> SELECTEDVALUE ( 'Cases'[Subject] ) )
			    )
			RETURN
			    1 - ( AllAvgExcept / AllAvg )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CSAT
		lineageTag: d6ad9465-2088-4d63-8ada-cc860779dfd6

		changedProperty = IsHidden

	/// CSAT lift attributable to a product. Use to prioritize product quality investments.
	measure 'CSAT Impact - Products' =
			
			VAR FactorAvg =
			    AVERAGE ( 'Cases'[CSAT] )
			VAR AllAvg =
			    CALCULATE ( AVERAGE ( 'Cases'[CSAT] ), ALL ( 'Cases' ) )
			VAR AllAvgExcept =
			    CALCULATE (
			        AVERAGE ( 'Cases'[CSAT] ),
			        FILTER ( ALL ( 'Cases' ), 'Cases'[ProductSeq] <> SELECTEDVALUE ( 'Cases'[ProductSeq] )  )
			    )
			RETURN
			    1 - ( AllAvgExcept / AllAvg )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CSAT
		lineageTag: f4feed20-bd0a-43c4-8be5-23d9f3273f9b

		changedProperty = IsHidden

	/// CSAT lift attributable to an agent. Use in coaching and agent scorecards.
	measure 'CSAT Impact - Agent' =
			
			VAR FactorAvg =
			    AVERAGE ( 'Cases'[CSAT] )
			VAR AllAvg =
			    CALCULATE ( AVERAGE ( 'Cases'[CSAT] ), ALL ( 'Cases' ) )
			VAR AllAvgExcept =
			    CALCULATE (
			        AVERAGE ( 'Cases'[CSAT] ),
			        FILTER ( ALL ( 'Cases' ), 'Cases'[Agent] <> SELECTEDVALUE ( 'Cases'[Agent] ) )
			    )
			RETURN
			    1 - ( AllAvgExcept / AllAvg )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CSAT
		lineageTag: ef6d8fce-51f5-4936-9423-a0488c22c86d

		changedProperty = IsHidden

	/// Case volume attributed to the Case Owner (agent-level owner from Owners table). Use for owner workload analysis.
	measure 'Case Count (by Case Owner)' = CALCULATE([Case Count], USERELATIONSHIP('Cases'[SystemUserSeq], 'Owners'[SystemUserSeq]))
		formatString: #,0
		displayFolder: Volume (by Case Owner)
		lineageTag: 254a5a27-6830-483b-8dc5-44389ef1fc53

	/// SLA compliance attributed to the Case Owner. Use in owner scorecards.
	measure 'SLA Compliance (by Case Owner)' = CALCULATE([SLA Compliance], USERELATIONSHIP('Cases'[SystemUserSeq], 'Owners'[SystemUserSeq]))
		formatString: #,0%;-#,0%;#,0%
		displayFolder: SLA & Escalations (by Case Owner)
		lineageTag: 2a13c0c5-cf4e-4fc9-9423-45a95159e532

	/// Escalation rate attributed to the Case Owner. Use in owner scorecards.
	measure 'Escalations (by Case Owner)' = CALCULATE([Escalations], USERELATIONSHIP('Cases'[SystemUserSeq], 'Owners'[SystemUserSeq]))
		formatString: #,0%;-#,0%;#,0%
		displayFolder: SLA & Escalations (by Case Owner)
		lineageTag: ac6c83f9-9fe8-4896-bc73-29d8a985b933

	/// When the case was opened. Use as the axis for case trend charts.
	column 'Case Created On'
		dataType: dateTime
		isHidden
		lineageTag: 8d66fdac-438e-43b5-be54-b472762f40b7
		summarizeBy: none
		sourceColumn: Case Created On

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Case lifecycle status (Open / Resolved / etc.). Use as a slicer.
	column Status
		dataType: string
		displayFolder: Details
		lineageTag: d3b915d2-5e59-40f5-9a49-5324cd62b738
		summarizeBy: none
		sourceColumn: Status

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Support agent handling the case. Use in agent scorecards and leaderboards.
	column Agent
		dataType: string
		displayFolder: Details
		lineageTag: 58eb8a8a-2b03-4516-a6b8-1f9595bbc184
		summarizeBy: none
		sourceColumn: Agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Short case title. Use in detail tables and tooltips.
	column Title
		dataType: string
		displayFolder: Details
		lineageTag: f2431a4a-f90a-42a5-8cfa-97ee266cd0f8
		summarizeBy: none
		sourceColumn: Title

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Channel where the case originated (Phone / Web / Email). Use to compare channel mix.
	column Origin
		dataType: string
		displayFolder: Details
		lineageTag: 8de93ff5-b24c-4ab5-9dcb-bfd0ac47935c
		summarizeBy: none
		sourceColumn: Origin

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// TRUE when the case was escalated. Use as a filter or to build the Escalations rate.
	column 'Is Escalated'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Details
		lineageTag: 173584ba-ed33-464f-91c8-6f54ffcd440c
		summarizeBy: none
		sourceColumn: Is Escalated

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Case topic category. Use as a slicer or on axis to see top drivers of volume.
	column Subject
		dataType: string
		displayFolder: Details
		lineageTag: 1dc3837f-8c40-4514-955d-9443c22509fb
		summarizeBy: none
