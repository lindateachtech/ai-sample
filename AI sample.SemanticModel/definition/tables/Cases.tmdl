	/// Customer satisfaction bucket (Positive / Neutral / Negative). Use as a slicer.
	column 'CSAT Label'
		dataType: string
		displayFolder: Metrics
		lineageTag: 4bf55f5a-744a-4d9b-9b01-9d866e2b120b
